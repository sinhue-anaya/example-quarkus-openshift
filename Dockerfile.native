####
# Before building the container image run:
#
# ./mvnw package -Dnative
#
# Then, build the image with:
#
# docker build -f Dockerfile.native -t quarkus/code-with-quarkus .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/code-with-quarkus
#
###

# =============================================================================
# STAGE 1: Native Build — GraalVM 21 + Maven
# =============================================================================
FROM ghcr.io/graalvm/native-image-community:21 AS builder

# Instalar Maven
RUN microdnf install -y maven && microdnf clean all

# Crear usuario no-root aquí (ubi-micro no tiene useradd)
# Se copiará /etc/passwd y /etc/group a la imagen final
RUN useradd -u 1001 -r -g 0 -s /sbin/nologin quarkus

WORKDIR /build

# Copiar descriptores de dependencias primero (mejor uso del caché de Docker)
COPY pom.xml ./
RUN mvn dependency:go-offline -B -q

# Copiar el código fuente
COPY src ./src

# Compilar el binario nativo con GraalVM
# -Pnative activa el profile nativo de Quarkus
# -DskipTests omite tests en build de producción (quitar si se desean ejecutar)
RUN mvn package -Pnative -DskipTests -B \
    -Dquarkus.native.additional-build-args="--no-fallback" \
    -Dquarkus.application.name=code-with-quarkus

# =============================================================================
# STAGE 2: Runtime Image — ubi9-minimal (GLIBC 2.34+, compatible con GraalVM 21)
# =============================================================================
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

WORKDIR /app

# Copiar únicamente el binario nativo generado en la etapa anterior
COPY --from=builder /build/target/*-runner /app/code-with-quarkus

# Copiar el usuario creado en la etapa de build
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group  /etc/group

# Exponer el puerto por defecto de Quarkus
EXPOSE 8080

# Variables de entorno recomendadas para Quarkus en contenedor
ENV QUARKUS_HTTP_HOST=0.0.0.0 \
    QUARKUS_HTTP_PORT=8080 \
    JAVA_OPTIONS="-Dfile.encoding=UTF-8"

# Usuario no-root para mejor seguridad
USER 1001

# Punto de entrada al binario nativo
ENTRYPOINT ["/app/code-with-quarkus"]